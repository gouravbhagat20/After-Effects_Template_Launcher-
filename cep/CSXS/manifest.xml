<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest ExtensionBundleId="com.bighappy.launcher"
                   ExtensionBundleName="BigHappy Launcher"
                   ExtensionBundleVersion="0.3.4"
                   Version="9.0"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.bighappy.launcher.panel" Version="0.3.4"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2021 (18.0) and later — the panel uses CEP 11
                 features (CEF 88 flex gap, Node 15 fs.mkdirSync recursive) -->
            <Host Name="AEFT" Version="[18.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.bighappy.launcher.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>BigHappy Launcher</Menu>
                    <Geometry>
                        <Size>
                            <Height>620</Height>
                            <Width>420</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>340</Width>
                        </MinSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
